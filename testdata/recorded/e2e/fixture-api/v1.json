{
  "openapi": "3.0.3",
  "info": {
    "title": "Fixture API",
    "version": "2025-01-01"
  },
  "paths": {
    "/v1/orders": {
      "get": {
        "summary": "List orders",
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}": {
      "get": {
        "summary": "Fetch an order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{id}/legacy": {
      "get": {
        "summary": "Fetch an order in the legacy shape",
        "description": "Use GET /v1/orders/{id} instead; it returns the total as an amount and a currency.",
        "deprecated": true,
        "x-sunset": "2027-03-01",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyOrder"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LegacyOrder": {
        "type": "object",
        "required": [
          "id",
          "total_cents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "total_cents": {
            "type": "integer"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "total_cents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "paid",
              "void"
            ]
          },
          "total_cents": {
            "type": "integer"
          }
        }
      }
    }
  }
}
