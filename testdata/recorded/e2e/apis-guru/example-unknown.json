{
  "openapi": "3.0.3",
  "info": {
    "title": "Example Unknown Inventory API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://api.example-unknown.com"
    }
  ],
  "paths": {
    "/v2/items": {
      "get": {
        "summary": "List items",
        "description": "Use GET /v3/items, which pages with a cursor; /v2/items stops answering after its sunset.",
        "deprecated": true,
        "x-sunset": "2027-06-30",
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v3/items": {
      "get": {
        "summary": "List items, a page at a time",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Item"
                      }
                    },
                    "next": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
