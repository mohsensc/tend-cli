--- /dev/null
+++ b/test/tend/characterization.js
@@ -0,0 +1,29 @@
+'use strict'
+
+const test = require('node:test')
+const assert = require('node:assert')
+const app = require('../../src/app')
+const client = require('../../src/client')
+
+test('health answers ok', () => {
+  assert.strictEqual(app.handle('/health'), 'ok')
+})
+
+test('an order reads its amount from the query', () => {
+  assert.strictEqual(app.handle('/order', '42'), 42)
+})
+
+test('the server starts and stops', () => {
+  const server = app.server()
+  assert.strictEqual(typeof server.close, 'function')
+  server.close()
+})
+
+test('a price is read in cents from the price service', (t, done) => {
+  globalThis.fetch = async () => ({ status: 200, text: async () => '{"cents":1250}' })
+  client.price('sku-1', (err, cents) => {
+    assert.ifError(err)
+    assert.strictEqual(cents, 1250)
+    done()
+  })
+})
diff --git a/test/tend/smoke.js b/test/tend/smoke.js
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/test/tend/smoke.js
@@ -0,0 +1,24 @@
+'use strict'
+
+const test = require('node:test')
+const assert = require('node:assert')
+const { spawnSync } = require('node:child_process')
+const path = require('node:path')
+const { pathToFileURL } = require('node:url')
+
+const root = path.join(__dirname, '..', '..')
+
+const modules = [
+  'src/app.js',
+  'src/client.js',
+  'src/order.js',
+]
+
+for (const m of modules) {
+  test('loads ' + m, () => {
+    const url = pathToFileURL(path.join(root, m)).href
+    const code = 'import(' + JSON.stringify(url) + ').then(() => process.exit(0), (e) => { process.stderr.write(String(e && e.stack || e)); process.exit(1) })'
+    const res = spawnSync(process.execPath, ['-e', code], { cwd: root, encoding: 'utf8', timeout: 30000 })
+    assert.strictEqual(res.status, 0, res.stderr)
+  })
+}
